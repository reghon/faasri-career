{
  "name": "faasri-career",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend start",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter backend start",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "deploy:frontend": "pnpm --filter frontend build && bash ./scripts/deploy-frontend.sh",
    "deploy:backend": "pnpm --filter backend build && bash ./scripts/deploy-backend.sh",
    "deploy": "pnpm build && bash ./scripts/deploy-frontend.sh && bash ./scripts/deploy-backend.sh"
  }
}
